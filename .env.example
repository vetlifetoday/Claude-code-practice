# Copy this file to .env.local (for your computer) and fill in the values.
# In Vercel, add the same names under Project > Settings > Environment Variables.
# NEVER commit .env.local or paste the secret key anywhere public.

# Supabase > Project Settings > API (or "Connect") > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase > Project Settings > API Keys > Publishable key (starts with sb_publishable_)
# (The legacy "anon" key also works.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase > Project Settings > API Keys > Secret key (starts with sb_secret_)
# (The legacy "service_role" key also works.) SERVER ONLY — used to invite users.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# The address people use to reach the app (no trailing slash).
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
